{
  "name": "asset-security-dashboard",
  "version": "0.1.0",
  "description": "Local asset inventory and security hygiene dashboard for small nonprofits.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "qa:visual": "npm run build && node scripts/verify-browser.mjs",
    "qa:update-gallery": "npm run build && node scripts/verify-browser.mjs --update-gallery"
  },
  "dependencies": {
    "lucide-react": "1.54.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "4.7.0",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}
